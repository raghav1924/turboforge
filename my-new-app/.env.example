# ==============================================
# Environment Configuration for my-new-app
# ==============================================

NODE_ENV=development
PORT=3000
API_PORT=4000

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Database / Supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my-new-app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI / MCP Gateway Credentials
OPENAI_API_KEY=sk-placeholder
ANTHROPIC_API_KEY=sk-placeholder
MCP_SERVER_SECRET=your-mcp-secret-token-here
